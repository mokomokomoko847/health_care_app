{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Build Debug APK (Development)",
      "type": "shell",
      "command": "fvm",
      "args": [
        "flutter",
        "build",
        "apk",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}